get_model_list <- function(df_models, outcome_var, model_col) {
  out <- df_models %>%
    filter(outcome == outcome_var) %>%
    arrange(.imp) %>%
    pull(!!sym(model_col))

  if (length(out) < 1) stop("No models found for outcome: ", outcome_var, call. = FALSE)
  out
}

