anx_curve <- make_spline_curve_rubin(anx_models, age_grid, "Anxiety symptoms")
dep_curve <- make_spline_curve_rubin(dep_models, age_grid, "Depressive symptoms")
si_curve  <- make_spline_curve_rubin(si_models,  age_grid, "Suicidal ideation")

mental_curves <- bind_rows(anx_curve, dep_curve, si_curve) %>%
  mutate(
    scale_factor = if_else(outcome == "Suicidal ideation", 100, 1),
    estimate     = estimate  * scale_factor,
    conf_low     = conf_low  * scale_factor,
    conf_high    = conf_high * scale_factor
  )

# Social
lon_curve <- make_spline_curve_rubin(lon_models, age_grid, "Loneliness")
sa_curve  <- make_spline_curve_rubin(sa_models,  age_grid, "Low social acceptance")
ss_curve  <- make_spline_curve_rubin(ss_models,  age_grid, "Low social support")

social_curves <- bind_rows(lon_curve, sa_curve, ss_curve)

# Well-being
se_curve <- make_spline_curve_rubin(se_models, age_grid, "Low self-esteem")
bi_curve <- make_spline_curve_rubin(bi_models, age_grid, "Body dissatisfaction")

wb_curves <- bind_rows(se_curve, bi_curve)

# Substance
alc_curve  <- make_spline_curve_rubin(alc_models,  age_grid,      "Problematic alcohol use")
drug_curve <- make_spline_curve_rubin(drug_models, age_grid_drug, "Illicit drug use")
smok_curve <- make_spline_curve_rubin(smok_models, age_grid,      "Smoking")

substance_curves <- bind_rows(alc_curve, drug_curve, smok_curve) %>%
  mutate(
    scale_factor = if_else(outcome %in% c("Illicit drug use", "Smoking"), 100, 1),
    estimate     = estimate  * scale_factor,
    conf_low     = conf_low  * scale_factor,
    conf_high    = conf_high * scale_factor
  )

## 5) Plot helper

plot_domain_spline <- function(curves_df, xlim, fill_col, line_col, xlab = NULL) {
  ggplot(curves_df, aes(x = da_reported_or_assigned, y = estimate)) +
    geom_ribbon(aes(ymin = conf_low, ymax = conf_high), fill = fill_col, alpha = 0.6) +
    geom_line(linewidth = 0.9, color = line_col) +
    geom_vline(xintercept = contrast_ages, linetype = "dashed", colour = "grey50", linewidth = 0.4) +
    facet_wrap(~ outcome, nrow = 1, scales = "free_y") +
    coord_cartesian(xlim = xlim) +
    scale_x_continuous(breaks = contrast_ages) +
    labs(x = xlab, y = NULL) +
    theme_classic() +
    theme(
      text             = element_text(family = "Times New Roman", size = 18),
      strip.text       = element_text(face = "bold"),
      strip.background = element_blank()
    )
}

